# ==============================================================================
# BeresBayar - Docker Compose Environment Configuration Template
# Salin berkas ini menjadi .env sebelum menjalankan: docker compose up -d --build
# ==============================================================================

# Laravel Application
APP_NAME=BeresBayar
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_URL=http://localhost:8000

# Database Configuration (MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=beresbayar
DB_USERNAME=beresuser
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_root_password
